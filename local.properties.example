# 이 파일을 local.properties 로 복사한 뒤 값을 채우세요. local.properties 는 .gitignore 대상입니다.

# Android SDK 경로
sdk.dir=/path/to/Android/sdk

# (선택) 공공데이터포털(data.go.kr) 에서 발급받은 "일반 인증키 (Decoding)" 값
#
# 앱 안의 "인증키 설정" 화면에서 직접 입력할 수도 있으므로 여기 비워 두어도 됩니다.
# PC 에서 개발할 때 매번 입력하기 번거로우면 여기에 넣으세요.
# 앱에 입력한 키가 있으면 그쪽이 우선합니다.
MOLIT_SERVICE_KEY=
